{
  "enabledPlugins": {
    "github@claude-plugins-official": true
  },
  "hooks": {
    "PreCompact": [
      { "matcher": "manual|auto", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-compact.sh\"", "timeout": 20 } ] }
    ],
    "SessionStart": [
      { "matcher": "compact|resume", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"", "timeout": 10 } ] }
    ]
  }
}
