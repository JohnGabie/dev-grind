# Cloudflare Pages
# O service worker e o index precisam ser sempre revalidados: se o Pages
# servir uma cópia velha do sw.js, o app instalado nunca descobre que existe
# versão nova — que é exatamente o problema que o PWA deveria resolver.
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Os bundles têm hash no nome, então podem ser imutáveis.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
